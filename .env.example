# FalkorDB Configuration (Local Docker or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=DocuDrift

# Groq LLM API Key (Sign up free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Search API Key (Optional for live web verification: https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
